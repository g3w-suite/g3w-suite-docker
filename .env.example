# Public hostname, for docker internal network aliases
WEBGIS_PUBLIC_HOSTNAME=dev.g3wsuite.it

# Persistent data folder (projects, database, uploads), mounted into "g3w-suite" container at: `/shared-volume`
WEBGIS_DOCKER_SHARED_VOLUME=./shared-volume

# Super user credentials (first run); subsequent changes must be made via web UI.
G3WSUITE_ADMIN_USERNAME=admin
G3WSUITE_ADMIN_PASSWORD=admin

# you can increase it to 240 or higher to prevent 502 errors in nginx.
G3WSUITE_GUNICORN_TIMEOUT=120

# HTTP server: gunicorn | granian
G3WSUITE_WEBSERVER=granian

##
# 🚨 PostGIS DB
##
G3WSUITE_POSTGRES_USER_LOCAL=g3wsuite
G3WSUITE_POSTGRES_PASS='89#kL8y3D'
G3WSUITE_POSTGRES_DBNAME=g3wsuite
G3WSUITE_POSTGRES_HOST=postgis
G3WSUITE_POSTGRES_PORT=5432

# OPTIONAL: whether activate [huey](https://github.com/coleifer/huey) (batch processing)
G3WSUITE_RUN_HUEY=False

# OPTIONAL: whether activate [frontend](https://github.com/g3w-suite/g3w-admin-frontend) module
FRONTEND=False

# PostgreSql Service, mounted into "postgis" container at: `./secrets/pg_service.conf`,
PGSERVICEFILE=/pg_service/pg_service.conf